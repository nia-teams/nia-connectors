{
  "name": "nia-connectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/src/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/src/index.js",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
